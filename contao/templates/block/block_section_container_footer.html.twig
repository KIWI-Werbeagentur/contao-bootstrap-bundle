{# Custom section that inherits container width, container padding + gutter from the layout's footer section #}
{% set _containerSize = layout.responsiveContainerSizeFooter|default %}
{% set _containerPaddingX = getContainerPaddingXClasses(layout, 'tl_layout', 'responsiveContainerPaddingXFooter')|join(' ') %}
{% set _gutter = getGutterClasses(layout.responsiveGutterFooter|default, 'footer')|join(' ') %}

<div id="{{ id }}" class="{{ id }}">
    <div class="{{ id }}__container custom-container {{ _containerSize }} {{ _containerPaddingX }}">
        <div class="{{ id }}__inside inside">
            <div class="{{ id }}__content row {{ _gutter }}">
                {{ content|raw }}
            </div>
        </div>
    </div>
</div>
