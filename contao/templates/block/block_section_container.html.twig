{# Basic section with a fixed-width Bootstrap container and the default horizontal container padding (the main partial's default, cx-default-main) - see block_section_container_flush for one without #}
<div id="{{ id }}" class="{{ id }}">
    <div class="{{ id }}__container custom-container container cx-default-main">
        <div class="{{ id }}__inside inside">
            <div class="{{ id }}__content row">
                {{ content|raw }}
            </div>
        </div>
    </div>
</div>
