{# Basic section with a full-width Bootstrap container-fluid and the default horizontal container padding (the main partial's default, cx-default-main) #}
<div id="{{ id }}" class="{{ id }}">
    <div class="{{ id }}__container custom-container container-fluid cx-default-main">
        <div class="{{ id }}__inside inside">
            <div class="{{ id }}__content row">
                {{ content|raw }}
            </div>
        </div>
    </div>
</div>
