  --spacing-gap: #{$grid-gutter-width};
  --spacing-gap-half: #{$grid-gutter-width / 2};
  --spacing-xxs: .5rem;
  --spacing-xs: 1rem;
  --spacing-sm: 1.75rem;
  --spacing-md: 2.5rem;
  --spacing-lg: 4rem;
  --spacing-xl: 6rem;
