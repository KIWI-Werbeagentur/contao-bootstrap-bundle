$sizes: {{ sizes }};
$named-sizes: none, gap, gap-half, xxs, xs, sm, md, lg, xl, xxl;

/* Value-derived vertical-spacing scale + dynamic `default`. Single source of truth:
   kiwi_bootstrap.grid.vertical-spacing. `default` resolves to the configured default
   custom property; the space-N steps carry their literal value. */
$kiwi-spacing-utilities: (
{% for e in spacingUtilities %}  "{{ e.suffix }}": {{ e.value }},
{% endfor %});

/* One class per option in the PHP $arrSpacings list ($sizes), keeping the
   --spacing-* / [data-spacing-*] indirection: a config-driven space-N / `default`
   takes its value from $kiwi-spacing-utilities; a still-enabled named bucket reads
   its --spacing-<bucket> variable. Both directions (pt/pb) are emitted. */
@each $breakpoint in map-keys($grid-breakpoints) {
  @each $size in $sizes {
    @include media-breakpoint-up($breakpoint) {
      $infix: breakpoint-infix($breakpoint, $grid-breakpoints);
      @if map-has-key($kiwi-spacing-utilities, $size) {
        $value: map-get($kiwi-spacing-utilities, $size);
        .pt#{$infix}-#{$size} {
          --spacing-top: #{$value};
        }
        .pb#{$infix}-#{$size} {
          --spacing-bottom: #{$value};
        }
      } @else if index($named-sizes, $size) != null {
        .pt#{$infix}-#{$size} {
          --spacing-top: var(--spacing-#{$size});
        }
        .pb#{$infix}-#{$size} {
          --spacing-bottom: var(--spacing-#{$size});
        }
      }
    }
  }
}

[data-spacing-top]{
  padding-top: var(--spacing-top);
}
[data-spacing-bottom]{
  padding-bottom: var(--spacing-bottom);
}
