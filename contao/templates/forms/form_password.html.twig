{% extends '@Contao/form_row_double.html.twig' %}

{% block label %}
    {% if this.label %}
        <label for="ctrl_{{ this.id }}"{% if this.class|default %} class="{{ this.class|default }}"{% endif %}>
            {% if this.mandatory|default %}
                <span class="invisible">{{ this.mandatoryField }} </span>{{ this.label|insert_tag_raw }}<span class="mandatory">*</span>
            {% else %}
                {{ this.label|insert_tag_raw }}
            {% endif %}
        </label>
    {% endif %}
{% endblock %}

{% block field %}
    {% set input_attributes = attrs(getAttributes.invoke()) %}

    <input{{ attrs()
        .set('type', 'password')
        .set('name', this.name)
        .set('id', "ctrl_#{this.id}")
        .addClass('text password form-control')
        .addClass('is-invalid', hasErrors.invoke())
        .addClass(this.class|default)
        .set('value', '')
        .set('autocomplete', 'new-password')
        .set('aria-describedby', "ctrl_#{this.id}_text", this.responsiveHelpBlock|default)
        .mergeWith(input_attributes)
    }}>
{% endblock %}

{% block label2 %}
    {% if this.confirmLabel %}
        <label for="ctrl_{{ this.id }}_confirm" class="confirm{% if this.class|default %} {{ this.class|default }}{% endif %}">
            {% if this.mandatory|default %}
                <span class="invisible">{{ this.mandatoryField }} </span>{{ this.confirmLabel|insert_tag_raw }}<span class="mandatory">*</span>
            {% else %}
                {{ this.confirmLabel|insert_tag_raw }}
            {% endif %}
        </label>
    {% endif %}
{% endblock %}

{% block field2 %}
    <input{{ attrs()
        .set('type', 'password')
        .set('name', "#{this.name}_confirm")
        .set('id', "ctrl_#{this.id}_confirm")
        .addClass('text password form-control')
        .addClass('is-invalid', hasErrors.invoke())
        .addClass(this.class|default)
        .set('value', '')
        .set('autocomplete', 'new-password')
        .mergeWith(attrs(getAttributes.invoke()))
    }}>

    {% if this.responsiveHelpBlock|default %}
        <div class="form-text" id="ctrl_{{ this.id }}_text">{{ this.responsiveHelpBlock|raw }}</div>
    {% endif %}

    {% if hasErrors.invoke() %}
        <div class="invalid-feedback">{{ getErrorAsString.invoke() }}</div>
    {% endif %}
{% endblock %}
