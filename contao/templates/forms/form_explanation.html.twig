{#- Contao 5.3 compat: Twig resolves an attribute through isset(), and Widget::__isset()
    only answers for keys in arrAttributes/arrConfiguration there - so keys the magic getter
    handles explicitly (`prefix`, `asEditorView`) read as null and the value is silently lost.
    From 5.7 __isset() ends in `null !== $this->__get($strKey)`, making the plain attribute work.
    Calling the getter directly works on both. Replace with `this.prefix` at the ^5.7 bump. -#}
{% set widgetPrefix = this.__get('prefix') %}

{% set wrapperAttributes = attrs()
    .addClass([widgetPrefix, 'explanation', 'form-group', this.class|default, this.rowClasses|default])
    .mergeWith(wrapperAttributes|default)
%}

<div{{ wrapperAttributes }}>
    <div class="form-control-plaintext">{{ this.text|default|sanitize_html('contao')|csp_inline_styles|encode_email|insert_tag_raw }}</div>
</div>
