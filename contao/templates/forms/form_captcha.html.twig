{% extends '@Contao/form_row.html.twig' %}

{% block label %}
    {% if this.label %}
        <label for="ctrl_{{ this.id }}"{% if this.class|default %} class="{{ this.class|default }}"{% endif %}>
            <span class="invisible">{{ this.mandatoryField }} </span>{{ this.label|insert_tag_raw }}<span class="mandatory">*</span>
        </label>
    {% endif %}
{% endblock %}

{% block field %}
    {% set input_attributes = attrs(getAttributes.invoke()) %}

    <input{{ attrs()
        .set('type', 'text')
        .set('name', this.name)
        .set('id', "ctrl_#{this.id}")
        .addClass('captcha mandatory form-control')
        .addClass(this.class|default)
        .addClass('is-invalid', hasErrors.invoke())
        .set('value', '')
        .set('aria-describedby', "captcha_text_#{this.id}" ~ (this.responsiveHelpBlock|default ? " ctrl_#{this.id}_text" : ''))
        .mergeWith(input_attributes)
        .setIfExists('placeholder', input_attributes.placeholder|default|insert_tag)
    }}>
    <div id="captcha_text_{{ this.id }}" class="captcha_text form-text{% if this.class|default %} {{ this.class|default }}{% endif %}">{{ getQuestion.invoke() }}</div>

    {% if this.responsiveHelpBlock|default %}
        <div class="form-text" id="ctrl_{{ this.id }}_text">{{ this.responsiveHelpBlock|raw }}</div>
    {% endif %}

    {#- Contao 5.3 compat: Twig resolves an attribute through isset(), and Widget::__isset()
        only answers for keys in arrAttributes/arrConfiguration there - `sum` is computed by the
        magic getter, so it reads as null and the hash lands in the wrong field after an error.
        From 5.7 __isset() ends in `null !== $this->__get($strKey)`, making the plain attribute
        work. Calling the getter directly works on both. Replace with `this.sum` at the ^5.7 bump. -#}
    <input type="hidden" name="{{ this.name }}_hash{{ hasErrors.invoke() ? 1 + this.__get('sum') ** 2 : '' }}" value="{{ hasErrors.invoke() ? getHash.invoke() : '' }}">

    {% if hasErrors.invoke() %}
        <div class="invalid-feedback">{{ getErrorAsString.invoke() }}</div>
    {% endif %}

    {% if not hasErrors.invoke() %}
        <div style="{{ 'display:none'|csp_unsafe_inline_style }}">
            <label for="ctrl_{{ this.id }}_hp">Do not fill in this field</label>
            <input type="text" name="{{ this.name }}_name" id="ctrl_{{ this.id }}_hp" value="">
        </div>
        {% if not this.__get('asEditorView') %}
            <script src="{{ getAjaxUrl.invoke() }}" data-id="{{ this.id }}" data-name="{{ this.name }}" async></script>
        {% endif %}
    {% endif %}
{% endblock %}
