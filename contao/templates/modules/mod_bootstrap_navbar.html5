<!-- indexer::stop -->

<nav class="<?= $this->class ?> block navbar navbar-<?= $this->theme ?><?php if ($this->breakpoint): ?> navbar-expand-<?= $this->breakpoint ?><?php endif; ?>"<?= $this->cssID ?> data-breakpoint-name="<?= $this->breakpoint?>" data-breakpoint-size="<?= $this->breakpointSize ?>"  style="--breakpoint-name:<?= $this->breakpoint?>;--breakpoint-size:<?= $this->breakpointSize ?? 0 ?>;<?= $this->style ?>">
    <?php $this->block('inner'); ?>
    <div class="navbar__container mod_bootstrapNavbar__container container-fluid">
        <?php if ($this->inlineSingleSRC || $this->singleSRC): ?>
            <a class="navbar__brand navbar-brand" href="{{env::base_url}}<?= $this->localePrefix ?>"<?php if ($this->inlineSingleSRC): ?> aria-label="<?= \Contao\StringUtil::specialchars($this->alt) ?>"<?php endif; ?>>
                <?php if ($this->inlineSingleSRC): ?>
                    <?= $this->inlineSingleSRC ?>
                <?php elseif ($this->logoPicture): ?>
                    <?php $this->insert('picture_default', $this->logoPicture); ?>
                <?php else:?>
                    <img src="<?= $this->singleSRC ?>"  alt="<?= \Contao\StringUtil::specialchars($this->alt) ?>">
                <?php endif;?>
            </a>
        <?php endif; ?>

        <button type="button" class="navbar__toggler navbar-toggler burger burger--<?= $this->animation ?>" data-bs-toggle="collapse"
                data-bs-target="#navbar-collapse-<?= $this->id ?>" aria-controls="navbar-collapse-<?= $this->id ?>"
                aria-expanded="false" aria-label="Toggle navigation">
            <?php $this->block('burger'); ?>
            <?php if ($this->animation): ?>
                <?php $this->insert("burger_{$this->animation}") ?>
            <?php else: ?>
                <span class="burger__line burger__line--1"></span>
                <span class="burger__line burger__line--2"></span>
                <span class="burger__line burger__line--3"></span>
            <?php endif; ?>
            <?php $this->endblock(); ?>
        </button>

        <?php $this->block('nav'); ?>
        <?php if ($this->navbarHtmlOutBefore): ?>
            <?= $this->navbarHtmlOutBefore ?>
        <?php endif; ?>
        <div class="navbar__nav collapse navbar-collapse" id="navbar-collapse-<?= $this->id ?>">
            <?php if ($this->navbarHtmlInBefore): ?>
                <?= $this->navbarHtmlInBefore ?>
            <?php endif; ?>
            <?= $this->navigationHTML ?>
            <?php if ($this->navbarHtmlInAfter): ?>
                <?= $this->navbarHtmlInAfter ?>
            <?php endif; ?>
        </div>
        <?php if ($this->navbarHtmlOutAfter): ?>
            <?= $this->navbarHtmlOutAfter ?>
        <?php endif; ?>
        <?php $this->endblock(); ?>
    </div>
    <?php $this->endblock(); ?>
</nav>
<!-- indexer::continue -->
